# Куда складывать JSON, сырые ответы и картинки (install.sh подставит абсолютный путь)
AFISHA_OUTPUT_DIR=output
# Представьтесь источникам честно: название проекта и контакт
AFISHA_USER_AGENT=afisha-parser/0.2 (+https://github.com/your-account/afisha-parser)
AFISHA_REQUEST_TIMEOUT=45
# Пауза между запросами к API, секунды
AFISHA_REQUEST_DELAY=0.5
AFISHA_MAX_RETRIES=6
AFISHA_IMAGE_CONCURRENCY=4

# ---------- Автономный режим (служба / команды run и daemon) ----------
# Какие города собирать (список и источники по городам: python -m afisha_parser cities).
# Для каждого города берутся все источники из AFISHA_SOURCES, которые его поддерживают
AFISHA_CITIES=msk,spb,nsk,ekb,kzn,krasnoyarsk,nnv,chelyabinsk,ufa,krd,smr,rostov,omsk,voronezh,perm,volgograd
AFISHA_SOURCES=kudago,timepad
# Вместо AFISHA_CITIES можно задать точные пары источник:город (работает, только если AFISHA_CITIES пустой)
# AFISHA_TARGETS=kudago:msk,timepad:omsk
# Горизонт сбора, дней
AFISHA_DAYS=30
# Как часто собирать, минут. После неудачного цикла повтор через AFISHA_RETRY_MINUTES
AFISHA_INTERVAL_MINUTES=180
AFISHA_RETRY_MINUTES=20
AFISHA_DOWNLOAD_IMAGES=true
AFISHA_SAVE_RAW=true
AFISHA_EVENTLY=true
# Трейлеры к кинопоказам источника и афиша проката TMDb (без ключа TMDb молча пропускаются)
AFISHA_MOVIES=true
AFISHA_NOW_PLAYING=true
# Сколько дней хранить снимки прошлых запусков, картинки без ссылок и сырые ответы
AFISHA_KEEP_DAYS=7
AFISHA_RAW_KEEP_DAYS=2

# ---------- Фильтр прошедших событий ----------
# Событие без времени окончания считается прошедшим через столько минут после начала
AFISHA_PAST_GRACE_MINUTES=0

# ---------- Timepad: dev.timepad.ru/api/oauth/ → сгенерировать токен (права на чтение) ----------
AFISHA_TIMEPAD_TOKEN=

# ---------- Отправка в бэкенд Evently (пусто — только файлы) ----------
AFISHA_EVENTLY_IMPORT_URL=
AFISHA_EVENTLY_IMPORT_TOKEN=
AFISHA_EVENTLY_IMPORT_CHUNK=200

# ---------- TMDb: themoviedb.org → Settings → API → «Ключ API» (короткий, v3) ----------
AFISHA_TMDB_API_KEY=
AFISHA_TMDB_REGION=RU
AFISHA_TMDB_LANGUAGE=ru-RU

# ---------- Скачивание файлов трейлеров (см. README: права на ролики) ----------
AFISHA_TRAILERS_DOWNLOAD=false
AFISHA_TRAILERS_PER_RUN=20
AFISHA_TRAILER_MAX_HEIGHT=720
AFISHA_TRAILER_MAX_MB=150
