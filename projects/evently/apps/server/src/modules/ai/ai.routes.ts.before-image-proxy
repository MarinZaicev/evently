import type { FastifyInstance } from 'fastify'
import { z } from 'zod'
import { prisma } from '@evently/db'

const ChatMessageSchema = z.object({
  role: z.enum(['user', 'assistant']),
  content: z.string().trim().min(1).max(2000),
})

const ChatBodySchema = z.object({
  message: z.string().trim().min(1).max(700),
  history: z.array(ChatMessageSchema).max(10).default([]),
})

const ModelAnswerSchema = z.object({
  eventIds: z.array(z.string()).min(1).max(4),
})

type UserIntent = {
  freeOnly: boolean
  budgetTotal: number | null
  maxTicketPrice: number | null
  partySize: number
  explicitMoscow: boolean
  evening: boolean
  dateMode: 'today' | 'tomorrow' | 'weekend' | null
  preferredCategories: string[]
  explicitCategories: string[]
}

type OllamaResponse = {
  message?: {
    role?: string
    content?: string
  }
  error?: string
}

const CATEGORY_KEYWORDS: Record<string, string[]> = {
  concert: [
    'концерт',
    'музыка',
    'музык',
    'послушать',
    'живой звук',
  ],

  theatre: [
