# ==========================================
# Evently Docker example configuration
# ==========================================

# PostgreSQL
POSTGRES_USER=evently
POSTGRES_PASSWORD=evently_dev_password
POSTGRES_DB=evently

# Host ports
EVENTLY_API_PORT=13000
EVENTLY_WEB_PORT=15173

# Default city
EVENTLY_DEFAULT_CITY=msk

# Parser synchronization
PARSER_SYNC_INTERVAL_MS=60000
PARSER_STALE_AFTER_HOURS=7

# Internal import API
IMPORT_API_KEY=docker-demo-import-key

# MAX
#
# Leave empty for local browser testing.
# Do not commit a real production token.
MAX_BOT_TOKEN=
